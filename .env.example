# Copy to `.env` in the repository root. Never commit `.env`.
# Used by: docker compose -f docker-compose.yml up -d

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,localhost,127.0.0.1,web
DJANGO_TIME_ZONE=UTC
DJANGO_SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=https://example.com,http://localhost,http://127.0.0.1

# Flutter / web origins. Do not use a wildcard in production.
CORS_ALLOWED_ORIGINS=https://example.com

# --- PostgreSQL (internal Docker network only) ---
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Aliases accepted by Django:
# DB_NAME=hrms
# DB_USER=hrms
# DB_PASSWORD=change-me
# DB_HOST=db
# DB_PORT=5432

# --- Redis / Celery (internal Docker network only) ---
REDIS_PASSWORD=change-me
# Compose overrides REDIS_URL / CELERY_* to the internal redis service.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_CONCURRENCY=2
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=90

# --- HTTP ---
NGINX_HTTP_PORT=80

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Email ---
PASSWORD_RESET_TIMEOUT=86400
FRONTEND_PASSWORD_RESET_URL=https://example.com/reset-password
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Uploads ---
MAX_DOCUMENT_UPLOAD_SIZE=10485760
DOCUMENT_EXPIRING_SOON_DAYS=30
LEAVE_ATTACHMENT_MAX_BYTES=5242880
MAX_PROFILE_IMAGE_UPLOAD_SIZE=2097152

# --- Object storage ---
# local = Docker volume (private; not served by Nginx).
# s3 = AWS S3, Cloudflare R2, MinIO, or other S3-compatible storage.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_QUERYSTRING_EXPIRE=300

# --- FCM (optional). Mount a credentials file into the container. ---
FIREBASE_CREDENTIALS_PATH=
