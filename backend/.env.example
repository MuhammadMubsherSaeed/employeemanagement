# Shared / local Django process (venv). Docker production uses the root `.env`.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,*
DJANGO_TIME_ZONE=UTC
DJANGO_SECURE_SSL_REDIRECT=False

# PostgreSQL (POSTGRES_* names; DB_* aliases are also accepted)
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DB_NAME=hrms
# DB_USER=hrms
# DB_PASSWORD=replace-with-a-strong-password
# DB_HOST=localhost
# DB_PORT=5432

# CORS (comma-separated origins; do not use a wildcard in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Password reset / email
PASSWORD_RESET_TIMEOUT=86400
FRONTEND_PASSWORD_RESET_URL=http://localhost:8080/reset-password
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Redis / Celery (optional for local venv; required in Docker production)
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Employee documents (bytes; default 10 MiB)
MAX_DOCUMENT_UPLOAD_SIZE=10485760
DOCUMENT_EXPIRING_SOON_DAYS=30
LEAVE_ATTACHMENT_MAX_BYTES=5242880
MAX_PROFILE_IMAGE_UPLOAD_SIZE=2097152

# Private object storage. ``local`` (default) uses MEDIA_ROOT for tests and
# development. ``s3`` is any S3-compatible provider (AWS S3, Cloudflare R2,
# MinIO, DigitalOcean Spaces). Never commit real credentials.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_QUERYSTRING_EXPIRE=300

# FCM (optional). Leave empty to keep in-app notifications without push delivery.
FIREBASE_CREDENTIALS_PATH=
