# Shared
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# PostgreSQL
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS (comma-separated origins; do not use a wildcard in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# JWT (infrastructure only; login endpoints are not implemented yet)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
